{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["bin.mjs", "src/**/*.mjs", "gui/alerts.mjs", "gui/placement.mjs", "gui/tray-icon.mjs", "gui/i18n.mjs", "gui/updater.mjs"]
}
